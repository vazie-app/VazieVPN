# ── Vazie baseline: written as if the repository were public ─────────────────────────────────
# Nothing secret and nothing a build can regenerate goes to GitHub. Project rules follow below
# and win over these (git applies the last matching rule), so a project can re-allow a file with `!`.

# OS and editors
.DS_Store
._*
Thumbs.db
*.swp
*~
.idea/
*.iml
*.ipr
*.iws
.vscode/
.zed/
.fleet/

# Claude Code: per-machine settings, launch configs and worktrees
.claude/settings.json
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/

# Secrets, keys, signing material
.env
.env.*
!.env.example
*.local
local.properties
secrets.properties
keystore.properties
signing.properties
key.properties
signKeystore/
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.p8
*.der
*.cer
*.mobileprovision
*.provisionprofile
Secrets.xcconfig
google-services.json
GoogleService-Info.plist
agconnect-services.json
credentials*.json
service-account*.json
.netrc
*.kdbx
*.kdb
*.keyx

# Build output, caches and binaries (all regenerated by the build or downloaded by it)
.gradle/
.kotlin/
build/
out/
captures/
.externalNativeBuild/
.cxx/
*.hprof
*.jar
*.aar
*.apk
*.aab
*.ap_
*.dex
*.so
*.a
*.dylib
*.xcframework/
*.ipa
*.dSYM/
*.dSYM.zip
DerivedData/
xcuserdata/
*.xcresult
.build/
.swiftpm/
Pods/
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo
target/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.log
*.zip

# Heavy local-only material: design mockups and source art live in iCloud, not in git
/design/

# ── Project rules ─────────────────────────────────────────────────────────────────────────────
# Gradle / Android build output
.gradle/
build/
**/build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# Python bytecode cache
__pycache__/
*.pyc

# IDE
# Output folders a Kotlin language server (e.g. in Zed) writes next to each module
bin/
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Local machine configuration — SDK paths, per-user tooling
local.properties
.claude/
project-tree.txt

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Signing and credentials. Vazie handles VPN key material, so this section is
# deliberately broad — nothing here may ever reach the repository.
*.jks
*.keystore
keystore.properties
signing.properties
key.properties
signKeystore/
google-services.json
agconnect-services.json
.env
.env.*
*.pem
# Private keys. `*.key` is intentionally broad: if a source asset ever needs that
# extension, add a targeted negation next to it rather than relaxing the rule.
*.key

# The pinned libXray archive is ~96 MB of native code. It is fetched and checksum-verified by
# :vpn:engine:xray, cached here, and never committed — see third-party/libxray/README.md.
third-party/libxray/*.zip

# Real VPN configurations must never be committed. Parser test fixtures are
# synthetic and live under src/test/resources/fixtures.
*.conf
!**/src/test/resources/fixtures/**/*.conf

# Stray copies of the direct APKs and baseline profiles that once appeared at app/direct/.
app/direct/
