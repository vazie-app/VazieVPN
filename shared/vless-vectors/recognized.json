        "transport": "tcp",
        "suggestedName": "Home relay"
      }
    },
    {
      "name": "a-fragment-with-a-stray-percent-survives-as-typed",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443#100% relay",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "none",
        "transport": "tcp",
        "suggestedName": "100% relay"
      }
    },
    {
      "name": "no-fragment-means-no-suggested-name",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "none",
        "transport": "tcp",
        "suggestedName": null
      }
    },
    {
      "name": "an-empty-fragment-means-no-suggested-name",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443#",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "none",
        "transport": "tcp",
        "suggestedName": null
      }
    },
    {
      "name": "older-parameter-spellings-mean-the-fields-they-always-meant",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=reality&peer=relay.example.net&fingerprint=firefox&publicKey=not-a-real-reality-public-key-0000000000000&shortId=0011223344556677&spiderX=%2F",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "reality",
        "transport": "tcp",
        "serverName": "relay.example.net",
        "fingerprint": "firefox",
        "spiderX": "/",
        "unknownParameterNames": []
      }
    },
    {
      "name": "security-and-transport-are-read-case-insensitively",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=TLS&type=WS",
