    },
    {
      "name": "the-highest-port-is-a-port",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:65535",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 65535,
        "security": "none",
        "transport": "tcp"
      }
    },
    {
      "name": "the-fragment-becomes-the-suggested-name-percent-decoded",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443#Home%20relay",
