        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "tls",
        "transport": "ws"
      }
    },
    {
      "name": "flow-is-read-case-insensitively",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=tls&flow=XTLS-RPRX-VISION",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "tls",
        "transport": "tcp",
        "flow": "xtls-rprx-vision"
      }
    },
    {
      "name": "an-empty-security-falls-back-to-none",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "none",
        "transport": "tcp"
      }
    },
    {
      "name": "an-empty-transport-falls-back-to-tcp",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?type=",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "none",
        "transport": "tcp"
      }
    },
    {
      "name": "whitespace-around-a-value-is-trimmed",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=%20tls%20&sni=%20relay.example.net%20",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "tls",
        "transport": "tcp",
        "serverName": "relay.example.net"
      }
    },
    {
      "name": "allow-insecure-accepts-one",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=tls&allowInsecure=1",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "tls",
        "transport": "tcp",
        "allowInsecure": true
      }
    },
    {
      "name": "allow-insecure-accepts-the-word-true",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=tls&insecure=true",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
        "host": "relay.example.net",
        "port": 443,
        "security": "tls",
        "transport": "tcp",
        "allowInsecure": true
      }
    },
    {
      "name": "allow-insecure-is-false-for-anything-else",
      "input": "vless://00000000-0000-4000-8000-000000000001@relay.example.net:443?security=tls&allowInsecure=yes",
      "expect": {
        "kind": "recognized",
        "protocol": "vless",
