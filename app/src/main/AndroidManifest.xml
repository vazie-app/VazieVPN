<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The vibration motor, and nothing else. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Vazie uses neither, and no library may bring them in: no advertising identifier, no install referrer. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />

    <!-- Split tunnelling lists apps with a launcher icon; a narrow query instead of QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VazieApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vazie">
        <!-- The one activity; the launcher entry is an alias. Exported for the `vazie-vpn://` deep links. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Vazie">

            <!-- A product-scoped scheme, and four hosts named one at a time. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vazie-vpn" android:host="home" />
                <data android:scheme="vazie-vpn" android:host="connections" />
                <data android:scheme="vazie-vpn" android:host="settings" />
                <data android:scheme="vazie-vpn" android:host="add-config" />
            </intent-filter>
        </activity>

